{
  "name": "palantiny",
  "version": "0.1.0",
  "description": "A local console that listens to public Bluetooth and Wi-Fi broadcasts around your Mac and models them as an ontology.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/narasim-teja/palantiny.git"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun --bun vite build --config web/vite.config.ts",
    "start": "bun run sensor:build && bun run server/index.ts",
    "server": "bun run server/index.ts",
    "sensor:build": "bash native/macos/build.sh",
    "fixture": "bun run scripts/fixture.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "hono": "^4.13.16",
    "lucide-react": "^1.70.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
