{
  "name": "palantiny",
  "version": "0.1.0",
  "description": "A local console that listens to public Bluetooth and Wi-Fi broadcasts around your Mac and models them as an ontology.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/narasim-teja/Palantiny.git"
  },
  "scripts": {
    "sensor:build": "bash sensor/build.sh",
    "collect": "bun run collector/index.ts",
    "web": "bun --bun next dev -H 127.0.0.1 -p 4117",
    "dev": "bun run scripts/dev.ts",
    "build": "bun --bun next build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "motion": "14.9.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
